{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FaceBridge",
  "version": "0.1.0",
  "identifier": "app.facebridge.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "FaceBridge",
        "width": 1120,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "backgroundColor": "#0f1318"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Run VRCFaceTracking modules and send face tracking to VRChat over OSC",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  }
}
